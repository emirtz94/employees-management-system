{
    "compilerOptions": {
        // "baseUrl": ".",
        "outDir": "./dist",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "module": "CommonJS",
        "target": "ES6",
        "moduleResolution": "node",
        "noFallthroughCasesInSwitch": true,
        "declaration": true,
        "incremental": true,
        "composite": true,
        "noEmitOnError": true,
        "noEmit": false,
        "emitDeclarationOnly": false,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "allowSyntheticDefaultImports": true,
    },
    "include": ["packages/**/*"],
    "exclude": ["node_modules", "dist"]
}